# Copy to .env (git-ignored). Nothing here is a secret: every service runs locally.
VDE_LOG_LEVEL=INFO
VDE_DATA_DIR=data

# --- local models (Ollama on the host, GPU) ---
VDE_OLLAMA_URL=http://127.0.0.1:11434
VDE_VLM_MODEL=qwen3-vl:8b-instruct
VDE_TEXT_MODEL=qwen2.5:7b
VDE_NUM_CTX=8192

# --- worker: which extractor answers queued documents (vlm, ocr, vertex, fake) ---
VDE_EXTRACTOR=vlm
VDE_FEW_SHOT=0

# --- serverless side: Floci locally; leave the endpoint empty for real AWS ---
VDE_AWS_ENDPOINT_URL=http://127.0.0.1:4566
VDE_AWS_REGION=us-east-1
VDE_BUCKET=vde-documents
VDE_TABLE=vde-jobs
# VDE_QUEUE_URL is printed by `terraform output` after `make infra-up`

# --- Vertex AI (bills a Google Cloud project; see docs/DEPLOY.md) ---
# VDE_VERTEX_PROJECT=
# VDE_VERTEX_LOCATION=us-central1
# VDE_VERTEX_MODEL=gemini-2.5-flash
